{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"require('fs').writeFileSync('app/versao.json', JSON.stringify({ v: process.env.VERCEL_GIT_COMMIT_SHA || String(Date.now()) }))\"",
  "installCommand": "",
  "outputDirectory": "app",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    { "source": "/versao.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(index.html)?", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
